# Copier ce fichier vers .env et remplacer tous les secrets.
APP_ENV=development
HTTP_PORT=8080

# Générer des valeurs aléatoires longues pour ces trois secrets.
APP_KEY=replace_with_a_long_random_application_secret
INTERNAL_API_TOKEN=replace_with_a_different_long_random_internal_token

MYSQL_DATABASE=whatsapp_gateway
MYSQL_USER=gateway
MYSQL_PASSWORD=replace_with_a_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_root_password

WHATSAPP_CLIENT_ID=personal-gateway
